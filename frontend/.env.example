# development | preview | production
APP_ENV=development

# Neon pooled connection (host contains "-pooler") for app traffic
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/rode?sslmode=require
# Neon direct connection for migrations (yarn db:migrate)
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/rode?sslmode=require

# Local development without Neon (embedded PostgreSQL via PGlite):
# DATABASE_URL=pglite://./.data/pglite

# Run migrations + base seed on server boot (use only for local/PGlite)
AUTO_MIGRATE=false
# Demo data (NEVER true in production)
DEMO_SEED=false

# First super admin (created only when no super admin exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

SESSION_HOURS=12
DB_POOL_MAX=5
